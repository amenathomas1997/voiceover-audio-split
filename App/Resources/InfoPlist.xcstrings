      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VoiceOver Audio Split lässt VoiceOver Änderungen mit deiner VoiceOver-Stimme ansagen und fragt Safari oder Chrome, welche Website geöffnet ist, wenn du Voreinstellungen für Websites festlegst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split asks VoiceOver to announce changes in your VoiceOver voice, and, if you set presets for websites, asks Safari or Chrome which website is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VoiceOver Audio Split pide a VoiceOver que anuncie los cambios con tu voz de VoiceOver y, si configuras preajustes para sitios web, pregunta a Safari o Chrome qué sitio web está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VoiceOver Audio Split demande à VoiceOver d’annoncer les changements avec votre voix VoiceOver et, si vous définissez des préréglages pour des sites web, demande à Safari ou Chrome quel site est ouvert."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split leitet die VoiceOver-Sprache auf ein Ohr und alle anderen Töne auf das andere. Nichts wird aufgenommen oder gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split lleva la voz de VoiceOver a un oído y todos los demás sonidos al otro. No se graba ni se guarda nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split envoie la voix de VoiceOver dans une oreille et tous les autres sons dans l’autre. Rien n’est enregistré ni conservé."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split verwendet die Kamera, um Texte, Etiketten und Codes zu lesen, die du davor hältst, Farben und Licht zu erkennen und vor einem Videoanruf deinen Bildausschnitt zu prüfen. Bilder werden auf diesem Mac analysiert und nie gespeichert; nur die Geld-Erkennung sendet ein Bild, und nur wenn du darum bittest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split checks whether your face is centered and well lit before a video call. Pictures are only analyzed on this Mac and never saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split usa la cámara para leer textos, etiquetas y códigos que acerques, identificar colores y luz, y revisar tu encuadre antes de una videollamada. Las imágenes se analizan en este Mac y nunca se guardan; solo el identificador de dinero envía una imagen, y solo cuando lo pides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split utilise la caméra pour lire les textes, étiquettes et codes que vous lui présentez, identifier les couleurs et la lumière, et vérifier votre cadrage avant un appel vidéo. Les images sont analysées sur ce Mac et jamais conservées ; seul l’identificateur de billets envoie une image, et uniquement à votre demande."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Mikrofontest von VoiceOver Audio Split hört einige Sekunden zu, um dir zu sagen, ob du klar zu hören bist. Nichts wird aufgenommen oder gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split's microphone check listens for a few seconds to tell you whether you sound clear. Nothing is recorded or saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La prueba de micrófono de VoiceOver Audio Split escucha unos segundos para decirte si se te oye con claridad. No se graba ni se guarda nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le test du micro de VoiceOver Audio Split écoute quelques secondes pour vous dire si l’on vous entend clairement. Rien n’est enregistré ni conservé."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
