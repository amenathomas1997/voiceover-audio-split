{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split lässt VoiceOver Änderungen mit deiner VoiceOver-Stimme ansagen und fragt Safari oder Chrome, welche Website geöffnet ist, wenn du Voreinstellungen für Websites festlegst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split asks VoiceOver to announce changes in your VoiceOver voice, and, if you set presets for websites, asks Safari or Chrome which website is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split pide a VoiceOver que anuncie los cambios con tu voz de VoiceOver y, si configuras preajustes para sitios web, pregunta a Safari o Chrome qué sitio web está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split demande à VoiceOver d’annoncer les changements avec votre voix VoiceOver et, si vous définissez des préréglages pour des sites web, demande à Safari ou Chrome quel site est ouvert."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split leitet die VoiceOver-Sprache auf ein Ohr und alle anderen Töne auf das andere. Nichts wird aufgenommen oder gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split lleva la voz de VoiceOver a un oído y todos los demás sonidos al otro. No se graba ni se guarda nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split envoie la voix de VoiceOver dans une oreille et tous les autres sons dans l’autre. Rien n’est enregistré ni conservé."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split verwendet die Kamera, um Texte, Etiketten und Codes zu lesen, die du davor hältst, Farben und Licht zu erkennen und vor einem Videoanruf deinen Bildausschnitt zu prüfen. Bilder werden auf diesem Mac analysiert und nie gespeichert; nur die Geld-Erkennung sendet ein Bild, und nur wenn du darum bittest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split uses the camera to read text, labels and codes you hold up, identify colors and light, and check your framing before a video call. Pictures are analyzed on this Mac and never saved; only the money identifier sends a picture, and only when you ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split usa la cámara para leer textos, etiquetas y códigos que acerques, identificar colores y luz, y revisar tu encuadre antes de una videollamada. Las imágenes se analizan en este Mac y nunca se guardan; solo el identificador de dinero envía una imagen, y solo cuando lo pides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split utilise la caméra pour lire les textes, étiquettes et codes que vous lui présentez, identifier les couleurs et la lumière, et vérifier votre cadrage avant un appel vidéo. Les images sont analysées sur ce Mac et jamais conservées ; seul l’identificateur de billets envoie une image, et uniquement à votre demande."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split verwendet das Mikrofon für den Mikrofontest, der einige Sekunden zuhört, um dir zu sagen, ob du klar zu hören bist, und, wenn du es aktivierst, für den Sprachbefehl „VoiceOver-Training starten“. Nichts wird aufgenommen, gespeichert oder gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split uses the microphone for the microphone check, which listens for a few seconds to tell you whether you sound clear, and, if you turn it on, to hear the voice command “Launch VoiceOver training”. Nothing is recorded, saved or sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split usa el micrófono para la prueba de micrófono, que escucha unos segundos para decirte si se te oye con claridad, y, si lo activas, para oír el comando de voz “Abrir entrenamiento de VoiceOver”. No se graba, guarda ni envía nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split utilise le micro pour le test du micro, qui écoute quelques secondes pour vous dire si l’on vous entend clairement, et, si vous l’activez, pour entendre la commande vocale « Lancer la formation VoiceOver ». Rien n’est enregistré, conservé ni envoyé."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split erkennt den Sprachbefehl „VoiceOver-Training starten“ auf deinem Mac, nur wenn du ihn in den Einstellungen aktivierst. Was du sagst, wird nie aufgenommen, gespeichert oder gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VoiceOver Audio Split recognizes the voice command “Launch VoiceOver training” on your Mac, only if you turn it on in Settings. What you say is never recorded, saved or sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split reconoce el comando de voz “Abrir entrenamiento de VoiceOver” en tu Mac, solo si lo activas en Ajustes. Lo que dices nunca se graba, guarda ni envía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split reconnaît la commande vocale « Lancer la formation VoiceOver » sur votre Mac, uniquement si vous l’activez dans les Réglages. Ce que vous dites n’est jamais enregistré, conservé ni envoyé."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
