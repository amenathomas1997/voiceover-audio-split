    "VoiceOver did not respond. Check the setting above. Until then, announcements use the Mac's standard voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver hat nicht reagiert. Prüfe die Einstellung oben. Bis dahin verwenden Ansagen die Standardstimme des Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver no respondió. Revisa el ajuste de arriba. Mientras tanto, los avisos usan la voz estándar de la Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver n'a pas répondu. Vérifiez le réglage ci-dessus. En attendant, les annonces utilisent la voix standard du Mac."
          }
        }
      }
    },
    "VoiceOver didn't start. Press Command F5 to turn it on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver wurde nicht gestartet. Drücke Befehl F5, um es einzuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver no se inició. Pulsa Comando F5 para activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver n'a pas démarré. Appuyez sur Commande F5 pour l'activer."
          }
        }
      }
    },
    "VoiceOver is in your left ear, and other sounds are in your right ear." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver ist in deinem linken Ohr, andere Töne sind in deinem rechten Ohr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver está en tu oído izquierdo y los demás sonidos en tu oído derecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver est dans votre oreille gauche, et les autres sons dans votre oreille droite."
          }
        }
      }
    },
    "VoiceOver is silenced" : {
      "localizations" : {
        "de" : {
