    "What should I find or press? For example, the search field, or press Play." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was soll ich finden oder drücken? Zum Beispiel das Suchfeld, oder drücke „Wiedergabe“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué debo buscar o pulsar? Por ejemplo, el campo de búsqueda, o pulsar Reproducir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que dois-je trouver ou activer ? Par exemple, le champ de recherche, ou appuyer sur Lecture."
          }
        }
      }
    },
    "What should have happened?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was hätte passieren sollen?"
          }
        },
