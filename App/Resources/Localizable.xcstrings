    },
    "There's no text to save" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Text zum Sichern vorhanden"
          }
        },
        "es" : {
          "stringUnit" : {
