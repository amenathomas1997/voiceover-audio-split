            "value" : "Rangée de repos, main gauche : A S D F"
          }
        }
      }
    },
    "Home row, right hand: J K L Semicolon" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundreihe, rechte Hand: J K L Semikolon"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila guía, mano derecha: J K L Punto y coma"
          }
        },
