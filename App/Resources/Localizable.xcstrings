          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta tus propios AppleScripts o atajos desde una tecla, el menú o la paleta de comandos. Si un script devuelve texto, se lee en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez vos propres AppleScripts ou raccourcis depuis une touche, le menu ou la palette de commandes. Si un script renvoie du texte, celui-ci est énoncé."
          }
        }
      }
    },
