        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja los momentos fuertes repentinos en videos, música y anuncios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atténue les passages soudainement forts dans les vidéos, la musique et les publicités."
          }
        }
      }
    },
