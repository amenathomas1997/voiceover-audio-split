          }
        }
      }
    },
    "Safari and Chrome" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari und Chrome"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari y Chrome"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari et Chrome"
          }
        }
      }
    },
    "Safari is the Mac's web browser. Command L goes to the address field: type a web address or a search, and press Return. Command T opens a new tab and Command W closes it. Command Left Bracket goes back a page, and Command R loads it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari ist der Webbrowser des Mac. Befehl L geht zum Adressfeld: Tippe eine Webadresse oder einen Suchbegriff und drücke den Zeilenschalter. Befehl T öffnet einen neuen Tab, und Befehl W schließt ihn. Befehl eckige Klammer links geht eine Seite zurück, und Befehl R lädt sie neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari es el navegador web de la Mac. Comando L va al campo de dirección: escribe una dirección web o una búsqueda y pulsa Retorno. Comando T abre una pestaña nueva y Comando W la cierra. Comando Corchete izquierdo vuelve a la página anterior, y Comando R la vuelve a cargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari est le navigateur web du Mac. Commande L va au champ d'adresse : tapez une adresse web ou une recherche, puis appuyez sur Retour. Commande T ouvre un nouvel onglet et Commande W le ferme. Commande Crochet gauche revient à la page précédente, et Commande R recharge la page."
          }
        }
      }
    },
