    "%@. Press Return to go on, R to hear something again, and Escape to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Drücke den Zeilenschalter, um weiterzumachen, R, um etwas noch einmal zu hören, und Escape zum Beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Pulsa Retorno para continuar, R para volver a oír algo y Escape para salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Appuyez sur Retour pour continuer, sur R pour réécouter, et sur Échap pour arrêter."
          }
        }
      }
    },
    "%@. Type each thing I say. Press Escape to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tippe alles, was ich sage. Drücke Escape zum Beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Escribe cada cosa que diga. Pulsa Escape para salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tapez tout ce que je dis. Appuyez sur Échap pour arrêter."
          }
        }
      }
    },
