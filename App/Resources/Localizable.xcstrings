            "value" : "Utiliser %@"
          }
        }
      }
    },
    "Use Clipboard" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischenablage verwenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar portapapeles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le presse-papiers"
          }
        }
      }
    },
    "Use Item Under VoiceOver Cursor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekt unter dem VoiceOver-Cursor verwenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar el ítem bajo el cursor de VoiceOver"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser l'élément sous le curseur VoiceOver"
          }
        }
      }
    },
    "Use Spotlight: Command Space, type Safari, and press Return. Come back here with Command Tab afterwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Spotlight: Befehl Leertaste, tippe Safari und drücke den Zeilenschalter. Komm danach mit Befehl Tab hierher zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Spotlight: Comando Espacio, escribe Safari y pulsa Retorno. Después vuelve aquí con Comando Tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Spotlight : Commande Espace, tapez Safari, puis appuyez sur Retour. Revenez ici ensuite avec Commande Tab."
          }
        }
      }
    },
    "Use Word's Heading 1, Heading 2 and so on for section titles, rather than bold or larger text, so people can jump between sections." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende für Abschnittstitel die Word-Formatvorlagen „Überschrift 1“, „Überschrift 2“ usw. statt fetter oder größerer Schrift, damit man zwischen Abschnitten springen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los estilos Título 1, Título 2, etc. de Word para los títulos de sección, en lugar de negrita o texto más grande, para poder saltar entre secciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les styles Titre 1, Titre 2, etc. de Word pour les titres de section, plutôt que du texte en gras ou plus grand, afin que l'on puisse passer d'une section à l'autre."
          }
        }
      }
    },
    "Use a nearby iPhone as the camera when available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein iPhone in der Nähe als Kamera verwenden, wenn verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar un iPhone cercano como cámara cuando esté disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser un iPhone à proximité comme caméra quand c'est possible"
          }
        }
      }
    },
    "Use a practice account, or have the learner email themselves. Reading a message means moving from the list into the message: show this with VO Right Arrow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende ein Übungskonto, oder lass die lernende Person sich selbst eine E-Mail schicken. Um eine E-Mail zu lesen, geht man von der Liste in die E-Mail: Zeige das mit VO Pfeil nach rechts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usen una cuenta de práctica, o pide a quien aprende que se envíe un correo a sí mismo. Leer un mensaje implica pasar de la lista al mensaje: muéstralo con VO Flecha derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un compte d'entraînement, ou demandez à l'apprenant de s'envoyer un courriel à lui-même. Pour lire un message, il faut passer de la liste au message : montrez-le avec VO Flèche droite."
          }
        }
      }
    },
    "Use heading levels in order, so a Heading %lld comes before any Heading %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Überschriftenebenen der Reihe nach, sodass eine Überschrift %lld vor jeder Überschrift %lld kommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los niveles de encabezado en orden, de modo que un Título %lld vaya antes que cualquier Título %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les niveaux de titre dans l'ordre : un Titre %lld doit précéder tout Titre %lld."
          }
        }
      }
    },
    "Use paragraph spacing or page breaks instead; screen readers announce each blank line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende stattdessen Absatzabstände oder Seitenumbrüche; Screenreader sagen jede Leerzeile an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa en su lugar el espaciado entre párrafos o saltos de página; los lectores de pantalla anuncian cada línea en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez plutôt l'espacement des paragraphes ou des sauts de page ; les lecteurs d'écran annoncent chaque ligne vide."
          }
        }
      }
    },
    "Use real examples from apps the learner uses. Before they press VO Space, ask them to predict what will happen from what VoiceOver said." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm echte Beispiele aus Apps, die die lernende Person nutzt. Bevor sie VO Leertaste drückt, lass sie anhand der Ansage von VoiceOver vorhersagen, was passieren wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa ejemplos reales de apps que use quien aprende. Antes de que pulse VO Espacio, pídele que adivine qué pasará a partir de lo que dijo VoiceOver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez de vrais exemples tirés des apps que l'apprenant utilise. Avant qu'il appuie sur VO Espace, demandez-lui de prédire ce qui va se passer d'après ce que VoiceOver a dit."
          }
        }
      }
    },
    "Use the VoiceOver keys to jump between headings, links, form controls and the table." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Springe mit den VoiceOver-Tasten zwischen Überschriften, Links, Formularelementen und der Tabelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa las teclas de VoiceOver para saltar entre encabezados, enlaces, controles de formulario y la tabla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les touches VoiceOver pour passer d'un titre, d'un lien, d'une commande de formulaire ou du tableau à l'autre."
          }
        }
      }
    },
    "Use the practice paragraph. Spelling a word with VO W twice builds confidence. Point out that reading keys never change anything, so they're always safe to try." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm den Übungsabsatz. Ein Wort mit zweimal VO W buchstabieren zu lassen, gibt Sicherheit. Weise darauf hin, dass Lesetasten nie etwas verändern und deshalb immer gefahrlos ausprobiert werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usen el párrafo de práctica. Deletrear una palabra con VO W dos veces da confianza. Señala que las teclas de lectura nunca cambian nada, así que siempre se pueden probar sin riesgo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le paragraphe d'entraînement. Épeler un mot avec VO W deux fois donne confiance. Soulignez que les touches de lecture ne modifient jamais rien : on peut toujours les essayer sans risque."
          }
        }
      }
    },
    "Use the session report to choose which lesson to go back to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entscheide anhand des Sitzungsberichts, welche Lektion als Nächstes wiederholt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el informe de la sesión para elegir a qué lección volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servez-vous du rapport de séance pour choisir la leçon à reprendre."
          }
        }
      }
    },
    "Using %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisation de %@."
          }
        }
      }
    },
    "Using %lld percent of one processor core now, %@ percent on average since it started, and %lld megabytes of memory. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet gerade %lld Prozent eines Prozessorkerns, seit dem Start durchschnittlich %@ Prozent und %lld Megabyte Arbeitsspeicher. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando ahora el %lld por ciento de un núcleo del procesador, %@ por ciento de media desde que se inició, y %lld megabytes de memoria. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise actuellement %lld pour cent d'un cœur de processeur, %@ pour cent en moyenne depuis son démarrage, et %lld mégaoctets de mémoire. %@"
          }
        }
      }
    },
