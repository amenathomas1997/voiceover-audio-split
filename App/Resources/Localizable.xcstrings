    },
    "S: silence VoiceOver. R: read the item under the VoiceOver cursor. H: speech history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S: VoiceOver stummschalten. R: Objekt unter dem VoiceOver-Cursor lesen. H: Sprachverlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S: silenciar VoiceOver. R: leer el ítem bajo el cursor de VoiceOver. H: historial de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
