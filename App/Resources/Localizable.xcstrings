    "Makes VoiceOver easier to understand over loud media, without just making it louder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht VoiceOver bei lauten Medien verständlicher, ohne es einfach lauter zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace que VoiceOver se entienda mejor sobre contenido alto, sin solo subirle el volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend VoiceOver plus facile à comprendre par-dessus des médias forts, sans simplement le rendre plus fort."
          }
        }
      }
    },
    "Makes one ear louder than the other, for people who hear less on one side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht ein Ohr lauter als das andere, für Menschen, die auf einer Seite schlechter hören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace que un oído suene más alto que el otro, para personas que oyen menos de un lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend une oreille plus forte que l'autre, pour les personnes qui entendent moins d'un côté."
          }
        }
      }
    },
