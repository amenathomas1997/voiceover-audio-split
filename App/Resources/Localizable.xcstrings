    "Plays silence so headphones and Bluetooth devices like AirPods don't go to sleep between phrases." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt Stille ab, damit Kopfhörer und Bluetooth-Geräte wie AirPods zwischen Sätzen nicht in den Ruhezustand gehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce silencio para que los audífonos y dispositivos Bluetooth como los AirPods no entren en reposo entre frases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffuse du silence pour que les écouteurs et les appareils Bluetooth comme les AirPods ne se mettent pas en veille entre les phrases."
          }
        }
      }
    },
