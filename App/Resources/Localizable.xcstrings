    "Use Item Under VoiceOver Cursor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekt unter dem VoiceOver-Cursor verwenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar el ítem bajo el cursor de VoiceOver"
          }
        },
