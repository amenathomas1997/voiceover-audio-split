            "value" : "Erlaube die Bildschirmaufnahme für VoiceOver Audio Split in „Systemeinstellungen“ > „Datenschutz & Sicherheit“ > „Bildschirm- & Systemaudioaufnahme“. Versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la grabación de pantalla para VoiceOver Audio Split en Ajustes del Sistema, Privacidad y seguridad, Grabación de pantalla y audio del sistema. Luego vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
