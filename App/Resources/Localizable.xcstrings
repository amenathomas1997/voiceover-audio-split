    "Blank lines are used for spacing in %lld places." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An %lld Stellen werden Leerzeilen als Abstand verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usan líneas en blanco como espaciado en %lld lugares."
          }
        },
