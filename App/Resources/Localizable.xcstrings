          }
        }
      }
    },
    "Without tags, screen readers can't tell headings, lists and tables apart. Export it again with \"Best for accessibility\" or tagged PDF turned on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Tags können Screenreader Überschriften, Listen und Tabellen nicht unterscheiden. Exportiere es erneut mit aktivierter Option „Optimal für Barrierefreiheit“ oder „PDF mit Tags“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin etiquetas, los lectores de pantalla no distinguen encabezados, listas y tablas. Vuelve a exportarlo con \"Mejor para accesibilidad\" o con PDF etiquetado activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans balises, les lecteurs d'écran ne peuvent pas distinguer les titres, les listes et les tableaux. Exportez-le de nouveau avec l'option « Optimisé pour l'accessibilité » ou PDF balisé activée."
          }
        }
      }
    },
