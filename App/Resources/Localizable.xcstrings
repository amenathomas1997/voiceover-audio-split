    "Switch to a preset on a website in Safari or Chrome, for example a quieter preset on youtube.com. The first time, your Mac asks to let VoiceOver Audio Split see which site is open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einer Website in Safari oder Chrome zu einer Voreinstellung wechseln, zum Beispiel zu einer leiseren auf youtube.com. Beim ersten Mal fragt dein Mac, ob VoiceOver Audio Split sehen darf, welche Website geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia a un preajuste en un sitio web en Safari o Chrome, por ejemplo un preajuste más bajo en youtube.com. La primera vez, tu Mac pide permitir que VoiceOver Audio Split vea qué sitio está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer à un préréglage sur un site web dans Safari ou Chrome, par exemple un préréglage plus silencieux sur youtube.com. La première fois, votre Mac demande d'autoriser VoiceOver Audio Split à voir quel site est ouvert."
          }
        }
      }
    },
    "Switch to a preset whenever an app comes to the front, for example Meeting for Zoom." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu einer Voreinstellung wechseln, sobald eine App in den Vordergrund kommt, zum Beispiel „Meeting“ für Zoom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia a un preajuste cada vez que una app pasa al frente, por ejemplo Reunión para Zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer à un préréglage chaque fois qu'une app passe au premier plan, par exemple Réunion pour Zoom."
          }
        }
      }
    },
