    "Command Space" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl Leertaste"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando Espacio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande Espace"
          }
        }
      }
    },
    "Command Space opens Spotlight. Command W closes, Command M minimizes, Command H hides, Command Q quits, Command Comma opens settings, and Option Command Escape force quits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl Leertaste öffnet Spotlight. Befehl W schließt, Befehl M legt im Dock ab, Befehl H blendet aus, Befehl Q beendet, Befehl Komma öffnet die Einstellungen, und Wahl Befehl Escape erzwingt das Beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando Espacio abre Spotlight. Comando W cierra, Comando M minimiza, Comando H oculta, Comando Q sale, Comando Coma abre los ajustes y Opción Comando Escape fuerza la salida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande Espace ouvre Spotlight. Commande W ferme, Commande M place dans le Dock, Commande H masque, Commande Q quitte, Commande Virgule ouvre les réglages, et Option Commande Échap force à quitter."
          }
        }
      }
    },
    "Command Space, type Keynote, press Return. If you don't have Keynote, press Return here to skip." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl Leertaste, tippe Keynote, drücke den Zeilenschalter. Wenn du Keynote nicht hast, drücke hier den Zeilenschalter, um es zu überspringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando Espacio, escribe Keynote y pulsa Retorno. Si no tienes Keynote, pulsa Retorno aquí para saltarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande Espace, tapez Keynote, appuyez sur Retour. Si vous n'avez pas Keynote, appuyez sur Retour ici pour passer cette étape."
          }
        }
      }
    },
    "Command Space, type Numbers, press Return. If you don't have Numbers, press Return here to skip." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl Leertaste, tippe Numbers, drücke den Zeilenschalter. Wenn du Numbers nicht hast, drücke hier den Zeilenschalter, um es zu überspringen."
          }
