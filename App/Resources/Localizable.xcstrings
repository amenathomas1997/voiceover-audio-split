    },
    "VoiceOver silenced. Read item speaks on request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver stumm. „Objekt lesen“ spricht auf Anfrage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver silenciado. Leer ítem habla cuando lo pidas."
          }
        },
        "fr" : {
