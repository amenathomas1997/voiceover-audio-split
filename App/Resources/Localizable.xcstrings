    "Return" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilenschalter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorno"
          }
        },
