    "Keep to two or three slides, and practise the slideshow controls, since presenting is usually the goal. Presenter notes are a good next step." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib bei zwei oder drei Folien und übe die Steuerung der Präsentation, denn meistens geht es ums Präsentieren. Moderatornotizen sind ein guter nächster Schritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limítense a dos o tres diapositivas y practiquen los controles de la presentación, ya que presentar suele ser el objetivo. Las notas del presentador son un buen paso siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitez-vous à deux ou trois diapositives, et entraînez-vous aux commandes du diaporama, car le but est généralement de présenter. Les notes de l'intervenant sont une bonne étape suivante."
          }
        }
      }
    },
    "Keeping audio awake" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio wird aktiv gehalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manteniendo el audio activo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio maintenu actif"
          }
        }
      }
    },
    "Keeps a list of what VoiceOver says, in memory only, to review and copy from the Speech History window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt eine Liste dessen, was VoiceOver sagt – nur im Arbeitsspeicher –, zum Nachlesen und Kopieren im Fenster „Sprachverlauf“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una lista de lo que dice VoiceOver, solo en memoria, para revisarla y copiar desde la ventana Historial de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve une liste de ce que dit VoiceOver, en mémoire uniquement, à consulter et copier depuis la fenêtre Historique de la parole."
          }
        }
      }
    },
    "Keeps all sound below this level to protect your hearing. It works on top of the Mac's volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält alle Töne unter diesem Pegel, um dein Gehör zu schützen. Wirkt zusätzlich zur Lautstärke des Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene todo el sonido por debajo de este nivel para proteger tu audición. Funciona además del volumen de la Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient tous les sons sous ce niveau pour protéger votre audition. Cela s'ajoute au volume du Mac."
          }
        }
      }
    },
    "Kept in memory only, never saved to disk. Includes this app's own announcements." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur im Arbeitsspeicher, nie auf der Festplatte gesichert. Enthält auch die eigenen Ansagen dieser App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda solo en memoria, nunca en el disco. Incluye los avisos de esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservé en mémoire uniquement, jamais enregistré sur le disque. Inclut les annonces de cette app."
          }
        }
      }
