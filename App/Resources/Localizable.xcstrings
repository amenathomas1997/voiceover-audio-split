    },
    "Thinking…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denkt nach …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensando…"
          }
        },
        "fr" : {
