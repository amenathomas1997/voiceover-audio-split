    "Bringing the VoiceOver cursor and keyboard focus together, describing things, locking the VO keys, and VoiceOver Utility." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver-Cursor und Tastaturfokus zusammenbringen, Dinge beschreiben lassen, die VO-Tasten feststellen und das VoiceOver-Dienstprogramm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juntar el cursor de VoiceOver y el foco del teclado, describir cosas, bloquear las teclas VO y Utilidad VoiceOver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réunir le curseur VoiceOver et le focus clavier, décrire les éléments, verrouiller les touches VO, et Utilitaire VoiceOver."
          }
        }
      }
    },
