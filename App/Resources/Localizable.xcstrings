    "Make each link say where it goes, such as \"2026 price list\", rather than \"click here\" or a web address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass jeden Link sagen, wohin er führt, etwa „Preisliste 2026“, statt „hier klicken“ oder einer Webadresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz que cada enlace diga adónde lleva, como \"lista de precios 2026\", en lugar de \"haz clic aquí\" o una dirección web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites en sorte que chaque lien indique sa destination, par exemple « tarifs 2026 », plutôt que « cliquez ici » ou une adresse web."
          }
        }
      }
    },
    "Makes VoiceOver easier to understand over loud media, without just making it louder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht VoiceOver bei lauten Medien verständlicher, ohne es einfach lauter zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace que VoiceOver se entienda mejor sobre contenido alto, sin solo subirle el volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend VoiceOver plus facile à comprendre par-dessus des médias forts, sans simplement le rendre plus fort."
          }
        }
      }
    },
    "Makes one ear louder than the other, for people who hear less on one side." : {
      "localizations" : {
        "de" : {
