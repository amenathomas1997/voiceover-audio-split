    "Audio mouse on. Higher means nearer the top of the screen; left and right follow your ears." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio-Maus ein. Höher bedeutet näher am oberen Bildschirmrand; links und rechts folgen deinen Ohren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratón sonoro activado. Más agudo significa más cerca de la parte superior de la pantalla; izquierda y derecha siguen a tus oídos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souris audio activée. Plus le son est aigu, plus le pointeur est près du haut de l'écran ; la gauche et la droite suivent vos oreilles."
          }
        }
      }
    },
