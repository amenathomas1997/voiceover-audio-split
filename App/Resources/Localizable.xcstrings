    "Remember to turn Quick Nav off before typing, or letters move you around instead of typing. When you're in a text field, VoiceOver usually types normally anyway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denke daran, die Schnellnavigation vor dem Tippen auszuschalten, sonst bewegen dich Buchstaben herum, statt getippt zu werden. In einem Textfeld tippt VoiceOver meist ohnehin normal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda desactivar la Navegación rápida antes de escribir, o las letras te moverán en lugar de escribirse. Cuando estás en un campo de texto, VoiceOver normalmente escribe con normalidad de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensez à désactiver la Navigation rapide avant de taper, sinon les lettres vous déplacent au lieu d'écrire. Quand vous êtes dans un champ de texte, VoiceOver tape généralement normalement de toute façon."
          }
        }
      }
    },
