        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la segunda de 40 filas, la que está elegida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur la deuxième des 40 lignes, celle qui est choisie"
          }
        }
      }
    },
