    "Choose another device, such as AirPods, to hear VoiceOver privately while other sounds play on the current output." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein anderes Gerät, etwa AirPods, um VoiceOver privat zu hören, während andere Töne über die aktuelle Ausgabe laufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige otro dispositivo, como unos AirPods, para oír VoiceOver en privado mientras los demás sonidos se reproducen en la salida actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un autre appareil, comme des AirPods, pour entendre VoiceOver en privé pendant que les autres sons sont diffusés sur la sortie actuelle."
          }
        }
      }
    },
