    "Allow screen recording for VoiceOver Audio Split in System Settings, Privacy and Security, Screen and System Audio Recording. Then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube die Bildschirmaufnahme für VoiceOver Audio Split in „Systemeinstellungen“ > „Datenschutz & Sicherheit“ > „Bildschirm- & Systemaudioaufnahme“. Versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la grabación de pantalla para VoiceOver Audio Split en Ajustes del Sistema, Privacidad y seguridad, Grabación de pantalla y audio del sistema. Luego vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'enregistrement de l'écran pour VoiceOver Audio Split dans Réglages Système, Confidentialité et sécurité, Enregistrement de l'écran et de l'audio du système. Puis réessayez."
          }
        }
      }
    },
