          }
        }
      }
    },
    "Keeps all sound below this level to protect your hearing. It works on top of the Mac's volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält alle Töne unter diesem Pegel, um dein Gehör zu schützen. Wirkt zusätzlich zur Lautstärke des Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene todo el sonido por debajo de este nivel para proteger tu audición. Funciona además del volumen de la Mac."
