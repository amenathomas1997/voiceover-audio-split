    "Now for real: put three numbers in a column, add them with a SUM formula, and save the spreadsheet with the name %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt wirklich: Gib drei Zahlen in eine Spalte ein, addiere sie mit einer SUMME-Formel und sichere die Tabelle unter dem Namen „%@“."
          }
        },
        "es" : {
