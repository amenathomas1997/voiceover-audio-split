    "VoiceOver Audio Split puts VoiceOver speech in one ear and other sounds in the other. A few permissions are needed first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split legt die VoiceOver-Sprache in ein Ohr und andere Töne in das andere. Zuerst sind einige Berechtigungen nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split pone la voz de VoiceOver en un oído y los demás sonidos en el otro. Primero se necesitan algunos permisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver Audio Split place la parole de VoiceOver dans une oreille et les autres sons dans l'autre. Quelques autorisations sont d'abord nécessaires."
          }
        }
      }
    },
    "VoiceOver Audio Split Settings" : {
      "localizations" : {
