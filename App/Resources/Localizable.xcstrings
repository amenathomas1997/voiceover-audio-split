          }
        }
      }
    },
    "Choose Blank in the template chooser. Command Semicolon finds the next misspelling. Command S saves, and File, Export To makes a Word or PDF copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle in der Vorlagenauswahl „Leer“. Befehl Semikolon findet den nächsten Rechtschreibfehler. Befehl S sichert, und Ablage, Exportieren erstellt eine Kopie als Word oder PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige En blanco en el selector de plantillas. Comando Punto y coma busca la siguiente palabra mal escrita. Comando S guarda, y Archivo, Exportar a crea una copia en Word o PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Vierge dans le sélecteur de modèles. Commande Point-virgule trouve le mot mal orthographié suivant. Commande S enregistre, et Fichier, Exporter vers crée une copie Word ou PDF."
          }
        }
      }
    },
    "Choose Radio, Podcasts, Audiobooks or News, then search." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Radio, Podcasts, Hörbücher oder Nachrichten und suche dann."
