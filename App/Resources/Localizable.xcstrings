          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'aurait-il dû se passer ?"
          }
        }
      }
    },
    "What the app is allowed to do. Each button opens the right page of System Settings, where you can turn VoiceOver Audio Split on or off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was die App darf. Jede Taste öffnet die passende Seite der Systemeinstellungen, wo du VoiceOver Audio Split ein- oder ausschalten kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que la app tiene permitido. Cada botón abre la página correcta de Ajustes del Sistema, donde puedes activar o desactivar VoiceOver Audio Split."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que l’app est autorisée à faire. Chaque bouton ouvre la bonne page de Réglages Système, où vous pouvez activer ou désactiver VoiceOver Audio Split."
          }
        }
      }
    },
    "What's On" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was läuft"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
