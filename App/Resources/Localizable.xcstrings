            "value" : "Mikrofonzugriff ist aus. Aktiviere VoiceOver Audio Split in „Systemeinstellungen“ > „Datenschutz & Sicherheit“ > „Mikrofon“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al micrófono está desactivado. Activa VoiceOver Audio Split en Ajustes del Sistema, Privacidad y seguridad, Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
