    "Identifying" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird erkannt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identificando"
          }
        },
        "fr" : {
