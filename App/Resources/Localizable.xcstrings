    "Option and the arrows move by word, Command and the arrows go to the ends of a line or the text, and Shift selects as you move. Command C copies, X cuts, V pastes and Z undoes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahl und die Pfeiltasten bewegen wortweise, Befehl und die Pfeiltasten gehen zum Anfang oder Ende einer Zeile oder des Textes, und Umschalt wählt beim Bewegen aus. Befehl C kopiert, X schneidet aus, V setzt ein und Z widerruft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opción y las flechas se mueven por palabra, Comando y las flechas van a los extremos de una línea o del texto, y Mayúsculas selecciona mientras te mueves. Comando C copia, X corta, V pega y Z deshace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option et les flèches se déplacent mot par mot, Commande et les flèches vont aux extrémités d'une ligne ou du texte, et Maj sélectionne pendant le déplacement. Commande C copie, X coupe, V colle et Z annule."
          }
        }
      }
    },
    "Option is needed too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst auch Wahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También hace falta Opción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut aussi Option."
          }
        }
      }
    },
