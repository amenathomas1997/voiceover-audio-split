            "value" : "mit Tab zwischen Bedienelementen wechseln, Markierungsfelder und Tasten verwenden und Dialoge bestätigen oder abbrechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "moverte entre controles con Tab, usar casillas y botones, y confirmar o cancelar cuadros de diálogo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "passer d'une commande à l'autre avec Tab, utiliser les cases à cocher et les boutons, et valider ou annuler des zones de dialogue."
          }
        }
      }
    },
    "moving the VoiceOver cursor item by item, going into and out of groups, pressing buttons, and jumping to the top of a window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "den VoiceOver-Cursor von Objekt zu Objekt bewegen, in Gruppen hinein- und wieder hinausgehen, Tasten drücken und zum Anfang eines Fensters springen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mover el cursor de VoiceOver ítem por ítem, entrar en grupos y salir de ellos, pulsar botones y saltar al principio de una ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "déplacer le curseur VoiceOver d'élément en élément, entrer dans les groupes et en sortir, activer des boutons, et aller en haut d'une fenêtre."
          }
        }
      }
    },
    "moving the text cursor by letter, word and line, selecting text, and copying, pasting and undoing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "die Einfügemarke buchstaben-, wort- und zeilenweise bewegen, Text auswählen sowie kopieren, einsetzen und widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mover el cursor de texto por letra, palabra y línea, seleccionar texto, y copiar, pegar y deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "déplacer le curseur de texte par lettre, mot et ligne, sélectionner du texte, puis copier, coller et annuler."
          }
        }
      }
    },
    "moving through your messages, reading one, and writing, replying to and sending email." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
