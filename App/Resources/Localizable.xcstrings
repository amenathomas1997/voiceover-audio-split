          }
        }
      }
    },
    "VoiceOver is already speaking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver spricht bereits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver ya está hablando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver parle déjà."
          }
        }
      }
    },
    "VoiceOver is in your left ear, and other sounds are in your right ear." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver ist in deinem linken Ohr, andere Töne sind in deinem rechten Ohr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver está en tu oído izquierdo y los demás sonidos en tu oído derecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver est dans votre oreille gauche, et les autres sons dans votre oreille droite."
          }
        }
      }
    },
    "VoiceOver is silenced" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
