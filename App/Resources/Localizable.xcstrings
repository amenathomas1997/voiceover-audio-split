    "What VoiceOver's descriptions mean: dimmed, selected, collapsed, rows, hints and more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was die Beschreibungen von VoiceOver bedeuten: abgeblendet, ausgewählt, reduziert, Zeilen, Hinweise und mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que significan las descripciones de VoiceOver: atenuado, seleccionado, contraído, filas, sugerencias y más."
