    "Equals and minus: the app in front louder or quieter. Zero: mute it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleichheitszeichen und Minus: die App im Vordergrund lauter oder leiser. Null: stummschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igual y menos: subir o bajar la app que está al frente. Cero: silenciarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Égal et moins : l'app au premier plan plus ou moins forte. Zéro : la couper."
          }
        }
      }
    },
