      }
    },
    "Your microphone is muted. Unmute it first, then check again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mikrofon ist stummgeschaltet. Hebe die Stummschaltung zuerst auf und prüfe dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu micrófono está silenciado. Activa el sonido primero y luego vuelve a probar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre micro est coupé. Réactivez-le d'abord, puis vérifiez de nouveau."
