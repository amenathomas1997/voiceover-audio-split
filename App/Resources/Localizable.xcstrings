    "Command N" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl N"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando N"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande N"
          }
        }
      }
    },
    "Command N starts a new message. In it, Tab moves from the To field to Cc, then Subject, then the message itself. Command Shift D sends it. Command R replies to a message, and Command Shift R replies to everyone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl N beginnt eine neue E-Mail. Darin geht Tab vom Feld „An“ zu „Kopie“, dann zu „Betreff“ und dann zum Text der E-Mail. Befehl Umschalt D sendet sie. Befehl R antwortet auf eine E-Mail, und Befehl Umschalt R antwortet allen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando N empieza un mensaje nuevo. En él, Tab pasa del campo Para a Cc, luego al Asunto y después al mensaje en sí. Comando Mayúsculas D lo envía. Comando R responde a un mensaje, y Comando Mayúsculas R responde a todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande N crée un nouveau message. Dans celui-ci, Tab passe du champ À au champ Cc, puis à l'Objet, puis au message lui-même. Commande Maj D l'envoie. Commande R répond à un message, et Commande Maj R répond à tous."
          }
        }
      }
    },
    "Command Palette" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehlspalette"
          }
        },
        "es" : {
          "stringUnit" : {
