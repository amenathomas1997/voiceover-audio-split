    "Describe image under VoiceOver cursor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bild unter dem VoiceOver-Cursor beschreiben"
          }
        },
        "es" : {
          "stringUnit" : {
