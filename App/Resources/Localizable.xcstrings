    "VO Shift M opens the shortcut menu for the item in the VoiceOver cursor. It's like a right-click." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Umschalt M öffnet das Kontextmenü für das Objekt im VoiceOver-Cursor. Das ist wie ein Rechtsklick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Mayúsculas M abre el menú de función rápida del ítem del cursor de VoiceOver. Es como hacer clic derecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Maj M ouvre le menu contextuel de l'élément dans le curseur VoiceOver. C'est comme un clic droit."
          }
        }
      }
    },
