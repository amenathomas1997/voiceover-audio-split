    "K: restart VoiceOver. E: compare text, once with the original copied and again with the new version. V: find a VoiceOver command. Comma: report a bug to Apple." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K: VoiceOver neu starten. E: Text vergleichen, einmal mit kopiertem Original und erneut mit der neuen Version. V: VoiceOver-Befehl suchen. Komma: Fehler an Apple melden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K: reiniciar VoiceOver. E: comparar texto, una vez con el original copiado y otra con la versión nueva. V: buscar un comando de VoiceOver. Coma: informar de un error a Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K : redémarrer VoiceOver. E : comparer du texte, une fois avec l'original copié, puis avec la nouvelle version. V : trouver une commande VoiceOver. Virgule : signaler un bug à Apple."
          }
        }
      }
    },
    "Keep Audio Awake (Prevents Clipped Words)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
