    },
    "Command S saves. Type a name, choose where with Tab if you like, and press Return. Command O opens a document, and Command W closes the window; if you haven't saved, TextEdit asks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl S sichert. Tippe einen Namen, wähle mit Tab, wo es gesichert wird, wenn du möchtest, und drücke den Zeilenschalter. Befehl O öffnet ein Dokument, und Befehl W schließt das Fenster; wenn du nicht gesichert hast, fragt TextEdit nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando S guarda. Escribe un nombre, elige dónde con Tab si quieres y pulsa Retorno. Comando O abre un documento y Comando W cierra la ventana; si no guardaste, TextEdit te pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande S enregistre. Tapez un nom, choisissez l'emplacement avec Tab si vous voulez, puis appuyez sur Retour. Commande O ouvre un document, et Commande W ferme la fenêtre ; si vous n'avez pas enregistré, TextEdit vous le demande."
          }
        }
      }
    },
    "Command S saves: type the name and press Return." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl S sichert: Tippe den Namen und drücke den Zeilenschalter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
