            "value" : "Touche enregistrée"
          }
        }
      }
    },
    "Keyboard Help: hear what any key does without doing it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastaturhilfe: hören, was eine Taste tut, ohne sie auszuführen"
