      }
    },
    "Unmute" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stummschaltung aufheben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el micrófono"
          }
        },
        "fr" : {
