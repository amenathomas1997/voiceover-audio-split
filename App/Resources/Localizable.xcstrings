    "VO U" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO U"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO U"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO U"
          }
        }
      }
    },
    "VO U opens the rotor: Left and Right Arrow choose a list, Up and Down Arrow an item, and Return goes there. VO I is the item chooser, and VO F finds text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO U öffnet den Rotor: Pfeil nach links und Pfeil nach rechts wählen eine Liste, Pfeil nach oben und Pfeil nach unten ein Objekt, und der Zeilenschalter springt dorthin. VO I ist die Objektauswahl, und VO F sucht Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO U abre el rotor: Flecha izquierda y Flecha derecha eligen una lista, Flecha arriba y Flecha abajo un ítem, y Retorno te lleva allí. VO I abre el selector de ítems, y VO F busca texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO U ouvre le rotor : Flèche gauche et Flèche droite choisissent une liste, Flèche haut et Flèche bas un élément, et Retour vous y amène. VO I ouvre le sélecteur d'éléments, et VO F trouve du texte."
          }
        }
      }
    },
    "VO V" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO V"
          }
        },
