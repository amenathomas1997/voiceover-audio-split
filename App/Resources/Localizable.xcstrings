      }
    },
    "Left Arrow or Right Arrow: put speech in that ear. Press again to turn the split off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfeil nach links oder Pfeil nach rechts: Sprache in dieses Ohr legen. Erneut drücken schaltet den Split aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flecha izquierda o Flecha derecha: poner la voz en ese oído. Pulsa de nuevo para desactivar la división."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flèche gauche ou Flèche droite : placer la parole dans cette oreille. Appuyez de nouveau pour désactiver la séparation."
          }
        }
      }
    },
    "Left Bracket" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eckige Klammer links"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corchete izquierdo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crochet gauche"
          }
        }
      }
    },
    "Left and Right Arrow together turn Quick Nav on and off. VO Q turns single-key Quick Nav on and off; then H, L and T jump by heading, link and table. Turn it off before typing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfeil nach links und Pfeil nach rechts zusammen schalten die Schnellnavigation ein und aus. VO Q schaltet die Einzeltasten-Schnellnavigation ein und aus; dann springen H, L und T nach Überschrift, Link und Tabelle. Schalte sie vor dem Tippen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flecha izquierda y Flecha derecha a la vez activan y desactivan la Navegación rápida. VO Q activa y desactiva la Navegación rápida de una tecla; entonces H, L y T saltan por encabezado, enlace y tabla. Desactívala antes de escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flèche gauche et Flèche droite ensemble activent et désactivent la Navigation rapide. VO Q active et désactive la Navigation rapide à une touche ; ensuite, H, L et T sautent par titre, lien et tableau. Désactivez-la avant de taper."
          }
        }
      }
    },
    "Left ear" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkes Ohr"
          }
        },
        "es" : {
