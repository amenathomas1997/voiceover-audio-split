    "You're too loud and may sound distorted. Move back a little or lower the input volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist zu laut und klingst eventuell verzerrt. Geh etwas zurück oder verringere die Eingangslautstärke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablas demasiado alto y podrías sonar distorsionado. Aléjate un poco o baja el volumen de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre voix est trop forte et peut sembler déformée. Reculez un peu ou baissez le volume d'entrée."
          }
        }
      }
    },
    "You're too quiet. Move closer to the microphone or raise the input volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist zu leise. Geh näher an das Mikrofon oder erhöhe die Eingangslautstärke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablas demasiado bajo. Acércate al micrófono o sube el volumen de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre voix est trop faible. Rapprochez-vous du micro ou augmentez le volume d'entrée."
          }
        }
      }
    },
