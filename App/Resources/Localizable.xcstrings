          }
        }
      }
    },
    "Move to it with VO Right Arrow, then press VO Space, or Space if it has the keyboard focus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe mit VO Pfeil nach rechts dorthin und drücke dann VO Leertaste, oder die Leertaste, wenn es den Tastaturfokus hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve hasta él con VO Flecha derecha y luego pulsa VO Espacio, o Espacio si tiene el foco del teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez-y avec VO Flèche droite, puis appuyez sur VO Espace, ou sur Espace s'il a le focus clavier."
          }
        }
      }
    },
