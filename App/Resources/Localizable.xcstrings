    },
    "The split is off. You've finished the tutorial. Open it again any time from the menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Split ist aus. Du hast das Tutorial abgeschlossen. Du kannst es jederzeit wieder über das Menü öffnen."
          }
