    "VO Shift F4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Umschalt F4"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Mayúsculas F4"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Maj F4"
          }
        }
      }
    },
    "VO Shift F4 and VO Command F4 bring the cursor and the focus together. VO F3, F2 and F1 describe the item, window and app. VO Semicolon locks the VO keys, and VO F8 opens VoiceOver Utility." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Umschalt F4 und VO Befehl F4 bringen Cursor und Fokus zusammen. VO F3, F2 und F1 beschreiben das Objekt, das Fenster und die App. VO Semikolon stellt die VO-Tasten fest, und VO F8 öffnet das VoiceOver-Dienstprogramm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Mayúsculas F4 y VO Comando F4 juntan el cursor y el foco. VO F3, F2 y F1 describen el ítem, la ventana y la app. VO Punto y coma bloquea las teclas VO, y VO F8 abre Utilidad VoiceOver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Maj F4 et VO Commande F4 réunissent le curseur et le focus. VO F3, F2 et F1 décrivent l'élément, la fenêtre et l'app. VO Point-virgule verrouille les touches VO, et VO F8 ouvre Utilitaire VoiceOver."
          }
        }
      }
    },
    "VO Shift M" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Umschalt M"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Mayúsculas M"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Maj M"
          }
        }
      }
    },
    "VO Shift M opens the shortcut menu for the item in the VoiceOver cursor. It's like a right-click." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Umschalt M öffnet das Kontextmenü für das Objekt im VoiceOver-Cursor. Das ist wie ein Rechtsklick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Mayúsculas M abre el menú de función rápida del ítem del cursor de VoiceOver. Es como hacer clic derecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Maj M ouvre le menu contextuel de l'élément dans le curseur VoiceOver. C'est comme un clic droit."
          }
        }
      }
    },
    "VO Shift Up Arrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Umschalt Pfeil nach oben"
