    "%@ keeps taking the sound back. To stop this, open %@ in System Settings and set Connect to This Mac to When Last Connected to This Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ holt sich den Ton immer wieder zurück. Um das zu verhindern, öffne %@ in den Systemeinstellungen und stelle „Mit diesem Mac verbinden“ auf „Bei letzter Verbindung mit diesem Mac“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sigue quitándote el sonido. Para evitarlo, abre %@ en Ajustes del Sistema y en Conectar a esta Mac elige Si fue la última conexión con esta Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reprend sans cesse le son. Pour éviter cela, ouvrez %@ dans Réglages Système et réglez « Se connecter à ce Mac » sur « Si la dernière connexion était avec ce Mac »."
          }
        }
      }
    },
