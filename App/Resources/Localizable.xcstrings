    "When the VoiceOver cursor is on text, you can read it in pieces of different sizes. VO A reads everything from the cursor onward. Press Control to stop it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der VoiceOver-Cursor auf Text steht, kannst du ihn in unterschiedlich großen Stücken lesen. VO A liest alles ab dem Cursor. Drücke Control, um es anzuhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el cursor de VoiceOver está sobre un texto, puedes leerlo en fragmentos de distintos tamaños. VO A lee todo desde el cursor en adelante. Pulsa Control para detenerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le curseur VoiceOver est sur du texte, vous pouvez le lire par morceaux de tailles différentes. VO A lit tout à partir du curseur. Appuyez sur Contrôle pour l'arrêter."
          }
        }
      }
    },
