    "The API key was not accepted. Check it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Schlüssel wurde nicht akzeptiert. Prüfe ihn in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se aceptó la clave de API. Revísala en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé API n'a pas été acceptée. Vérifiez-la dans les réglages."
          }
        }
      }
    },
    "The assistant and image descriptions use Claude. Paste an API key from console.anthropic.com. It is stored in your Mac's Keychain. Requests are billed to that account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent und die Bildbeschreibungen verwenden Claude. Füge einen API-Schlüssel von console.anthropic.com ein. Er wird im Schlüsselbund deines Mac gesichert. Anfragen werden diesem Konto in Rechnung gestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente y las descripciones de imágenes usan Claude. Pega una clave de API de console.anthropic.com. Se guarda en el llavero de tu Mac. Las solicitudes se cobran a esa cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistant et les descriptions d'images utilisent Claude. Collez une clé API obtenue sur console.anthropic.com. Elle est stockée dans le trousseau de votre Mac. Les requêtes sont facturées à ce compte."
          }
        }
      }
    },
    "The assistant and image descriptions use Claude. Paste an API key from console.anthropic.com. Requests are billed to that account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent und die Bildbeschreibungen verwenden Claude. Füge einen API-Schlüssel von console.anthropic.com ein. Anfragen werden diesem Konto in Rechnung gestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente y las descripciones de imágenes usan Claude. Pega una clave de API de console.anthropic.com. Las solicitudes se cobran a esa cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistant et les descriptions d'images utilisent Claude. Collez une clé API obtenue sur console.anthropic.com. Les requêtes sont facturées à ce compte."
          }
        }
      }
    },
