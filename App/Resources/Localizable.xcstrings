    "VO M" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO M"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO M"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO M"
          }
        }
      }
    },
    "VO M is the menu bar, VO M twice the menu extras, VO D the Dock, and VO Shift M the shortcut menu. Command Tab switches apps, and Command Grave Accent switches windows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO M ist die Menüleiste, zweimal VO M die Menüextras, VO D das Dock und VO Umschalt M das Kontextmenü. Befehl Tab wechselt die App, und Befehl Gravis wechselt das Fenster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO M va a la barra de menús, VO M dos veces a los extras de la barra de menús, VO D al Dock y VO Mayúsculas M abre el menú de función rápida. Comando Tab cambia de app, y Comando Acento grave cambia de ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO M va à la barre des menus, VO M deux fois aux menus supplémentaires, VO D au Dock, et VO Maj M ouvre le menu contextuel. Commande Tab change d'app, et Commande Accent grave change de fenêtre."
          }
        }
      }
    },
    "VO M, twice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
