    "Pick a short, meaningful text, such as a note to a friend. In the save dialog, check the name was typed before Return is pressed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen kurzen Text, der etwas bedeutet, etwa eine Nachricht an eine Freundin oder einen Freund. Prüfe im Sichern-Dialog, ob der Name eingetippt ist, bevor der Zeilenschalter gedrückt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elijan un texto breve y con sentido, como una nota para un amigo. En el cuadro de diálogo de guardar, comprueba que se escribió el nombre antes de pulsar Retorno."
          }
        },
        "fr" : {
          "stringUnit" : {
