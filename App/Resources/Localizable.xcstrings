          }
        }
      }
    },
    "Command Space, type TextEdit, press Return. Come back here with Command Tab afterwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl Leertaste, tippe TextEdit, drücke den Zeilenschalter. Komm danach mit Befehl Tab hierher zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando Espacio, escribe TextEdit y pulsa Retorno. Después vuelve aquí con Comando Tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande Espace, tapez TextEdit, appuyez sur Retour. Revenez ici ensuite avec Commande Tab."
          }
