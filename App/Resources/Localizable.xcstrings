    "Missed something? VO Z says the last thing again, and VO Shift C copies it to the clipboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas verpasst? VO Z sagt das Letzte noch einmal, und VO Umschalt C kopiert es in die Zwischenablage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te perdiste algo? VO Z repite lo último que se dijo, y VO Mayúsculas C lo copia al portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez manqué quelque chose ? VO Z répète la dernière chose dite, et VO Maj C la copie dans le presse-papiers."
          }
        }
      }
    },
