    "Home row, left hand: A S D F" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundreihe, linke Hand: A S D F"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila guía, mano izquierda: A S D F"
          }
        },
        "fr" : {
