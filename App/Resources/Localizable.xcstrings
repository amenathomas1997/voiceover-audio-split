    "Command L" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl L"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando L"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande L"
          }
        }
      }
    },
    "Command L is the address field, Command T and Command W open and close tabs, Command Left Bracket goes back, Command F finds, and Command Shift R shows Reader." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl L ist das Adressfeld, Befehl T und Befehl W öffnen und schließen Tabs, Befehl eckige Klammer links geht zurück, Befehl F sucht, und Befehl Umschalt R zeigt den Reader."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando L va al campo de dirección, Comando T y Comando W abren y cierran pestañas, Comando Corchete izquierdo vuelve atrás, Comando F busca y Comando Mayúsculas R muestra Lector."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande L va au champ d'adresse, Commande T et Commande W ouvrent et ferment des onglets, Commande Crochet gauche revient en arrière, Commande F recherche, et Commande Maj R affiche Lecteur."
          }
        }
      }
    },
    "Command L, type the address, Return. Then Command D, and Return to add the bookmark." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl L, tippe die Adresse, Zeilenschalter. Dann Befehl D und der Zeilenschalter, um das Lesezeichen hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando L, escribe la dirección y pulsa Retorno. Luego Comando D, y Retorno para añadir el marcador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande L, tapez l'adresse, Retour. Puis Commande D, et Retour pour ajouter le signet."
          }
        }
      }
    },
    "Command L, type the address, and Return. Get an overview with the rotor's headings list, jump with VO Command H, and read with VO A." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl L, tippe die Adresse, Zeilenschalter. Verschaffe dir mit der Überschriftenliste im Rotor einen Überblick, springe mit VO Befehl H und lies mit VO A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando L, escribe la dirección y pulsa Retorno. Ten una vista general con la lista de encabezados del rotor, salta con VO Comando H y lee con VO A."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande L, tapez l'adresse, puis Retour. Ayez une vue d'ensemble avec la liste des titres du rotor, sautez avec VO Commande H, et lisez avec VO A."
          }
        }
      }
    },
    "Command Left Bracket" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl eckige Klammer links"
          }
        },
        "es" : {
