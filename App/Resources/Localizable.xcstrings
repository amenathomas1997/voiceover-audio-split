            "value" : "Identifier de l'argent"
          }
        }
      }
    },
    "Identify a Color" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe erkennen"
          }
        },
        "es" : {
