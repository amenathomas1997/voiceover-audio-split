    "Going inside a group, such as a table, a list or a web page, with VO Shift Down Arrow, so you can move among the items in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In eine Gruppe hineingehen, etwa eine Tabelle, eine Liste oder eine Webseite, mit VO Umschalt Pfeil nach unten, um dich zwischen ihren Objekten zu bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
