    "Left Arrow and Right Arrow together" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfeil nach links und Pfeil nach rechts zusammen"
          }
        },
        "es" : {
