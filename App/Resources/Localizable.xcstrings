    "Music keeps its stereo sound but leans toward its ear. Off mixes other sounds to mono, like JAWS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik behält ihren Stereoklang, neigt sich aber zu ihrem Ohr. Aus mischt andere Töne in Mono, wie bei JAWS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La música mantiene su sonido estéreo pero se inclina hacia su oído. Desactivado, mezcla los demás sonidos en mono, como JAWS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La musique garde son son stéréo mais penche vers son oreille. Désactivé, les autres sons sont mixés en mono, comme avec JAWS."
          }
        }
      }
    },
