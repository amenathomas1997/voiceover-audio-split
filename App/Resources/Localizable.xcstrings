        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O: Lector de documentos. N: Escanear y leer. U: subtítulos en letra grande. Y: marco de foco. P: centro de audio. J: reproducir o pausar el centro de audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
