    "Up Arrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfeil nach oben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flecha arriba"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flèche haut"
          }
        }
      }
    },
    "Up Arrow: speech louder. Down Arrow: other sounds louder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfeil nach oben: Sprache lauter. Pfeil nach unten: andere Töne lauter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flecha arriba: voz más alta. Flecha abajo: demás sonidos más altos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flèche haut : parole plus forte. Flèche bas : autres sons plus forts."
          }
        }
      }
    },
    "Use %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
