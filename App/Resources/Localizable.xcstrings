    "VO Right Arrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Pfeil nach rechts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Flecha derecha"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Flèche droite"
          }
        }
      }
    },
    "VO Right and Left Arrow move by item. VO Shift Down Arrow goes into a group and VO Shift Up Arrow comes out. VO Space presses, and VO Home goes to the top." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Pfeil nach rechts und Pfeil nach links bewegen von Objekt zu Objekt. VO Umschalt Pfeil nach unten geht in eine Gruppe hinein, und VO Umschalt Pfeil nach oben wieder hinaus. VO Leertaste drückt, und VO Pos1 geht nach oben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Flecha derecha y Flecha izquierda se mueven por ítem. VO Mayúsculas Flecha abajo entra en un grupo y VO Mayúsculas Flecha arriba sale. VO Espacio pulsa, y VO Inicio va al principio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO Flèche droite et VO Flèche gauche se déplacent d'élément en élément. VO Maj Flèche bas entre dans un groupe et VO Maj Flèche haut en sort. VO Espace active, et VO Début va en haut."
          }
        }
      }
    },
    "VO Semicolon" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
