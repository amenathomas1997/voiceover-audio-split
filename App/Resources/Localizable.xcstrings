          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide à la saisie"
          }
        }
      }
    },
    "Input help off" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingabehilfe aus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda de entrada desactivada"
          }
        },
        "fr" : {
          "stringUnit" : {
