        }
      }
    },
    "Single-key Quick Nav goes further on web pages: H for the next heading, L for the next link, T for the next table, and Shift with the letter to go back. VO Q turns it on or off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einzeltasten-Schnellnavigation geht auf Webseiten noch weiter: H für die nächste Überschrift, L für den nächsten Link, T für die nächste Tabelle, und Umschalt mit dem Buchstaben, um zurückzugehen. VO Q schaltet sie ein oder aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Navegación rápida de una tecla va más allá en las páginas web: H para el siguiente encabezado, L para el siguiente enlace, T para la siguiente tabla, y Mayúsculas con la letra para volver atrás. VO Q la activa o desactiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Navigation rapide à une touche va plus loin sur les pages web : H pour le titre suivant, L pour le lien suivant, T pour le tableau suivant, et Maj avec la lettre pour revenir en arrière. VO Q l'active ou la désactive."
          }
        }
      }
    },
    "Skip Step" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
