    },
    "To describe an image, a picture of the item under your VoiceOver cursor is sent to Anthropic. Only that picture is sent, and only when you ask. You can turn this off in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ein Bild zu beschreiben, wird ein Bild des Objekts unter deinem VoiceOver-Cursor an Anthropic gesendet. Nur dieses Bild wird gesendet, und nur, wenn du darum bittest. Du kannst das in den Einstellungen ausschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para describir una imagen, se envía a Anthropic una imagen del ítem bajo tu cursor de VoiceOver. Solo se envía esa imagen, y solo cuando lo pides. Puedes desactivarlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour décrire une image, une image de l'élément sous votre curseur VoiceOver est envoyée à Anthropic. Seule cette image est envoyée, et seulement quand vous le demandez. Vous pouvez désactiver cette option dans les réglages."
          }
        }
      }
    },
    "Too many requests right now. Try again in a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade zu viele Anfragen. Versuche es in einer Minute erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas solicitudes en este momento. Vuelve a intentarlo en un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de requêtes pour le moment. Réessayez dans une minute."
          }
        }
      }
    },
    "Topic to look up" : {
      "localizations" : {
        "de" : {
