#!/bin/zsh
# Runs as root before the app is copied into /Applications.
# Quit a running copy so it can be replaced, and remove the older script version
# (AppleScripts and helper apps in ~/Applications), whose shortcuts clash with the app's.
USER_NAME=$(stat -f%Su /dev/console)
USER_ID=$(id -u "$USER_NAME" 2>/dev/null)
# /Search also finds network and mobile accounts, not just local ones.
# The whole value: a home folder's name can contain spaces, and a long one goes on the next line.
USER_HOME=$(dscl /Search -read "/Users/$USER_NAME" NFSHomeDirectory 2>/dev/null | sed -e '1s/^NFSHomeDirectory:[[:space:]]*//' -e 's/^[[:space:]]*//' | tr -d '\n')
[[ -d "$USER_HOME" ]] || USER_HOME=""

pkill -x "VoiceOver Audio Split" 2>/dev/null

if [[ -n "$USER_HOME" && -n "$USER_ID" ]]; then
  OLD_AGENT="$USER_HOME/Library/LaunchAgents/local.voaudiosplit.keys.plist"
  if [[ -f "$OLD_AGENT" ]]; then
    launchctl bootout "gui/$USER_ID" "$OLD_AGENT" 2>/dev/null
    rm -f "$OLD_AGENT"
  fi
  pkill -x VOAudioSplitKeys 2>/dev/null
  pkill -x VOAudioSplit 2>/dev/null
  rm -rf "$USER_HOME/Applications/VoiceOver Audio Split" \
         "$USER_HOME/Applications/VO Audio Split.app" "$USER_HOME/Applications/VO Audio Split Keys.app"
fi
exit 0
